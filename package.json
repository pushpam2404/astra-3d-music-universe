{
  "name": "astra-3d-music-universe",
  "version": "1.0.0",
  "description": "Explore your Spotify listening history as a 3D map: genres as planets, artists as orbiting bodies, songs as moons.",
  "keywords": [
    "spotify",
    "threejs",
    "webgl",
    "data-visualization",
    "music"
  ],
  "homepage": "https://astra-3d-music-universe.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pushpam2404/astra-3d-music-universe.git"
  },
  "author": "Pushpam Raj Satyarthi",
  "license": "MIT",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch-path=./server server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js --production",
    "preview": "vite preview",
    "test": "node --test \"tests/unit/*.test.js\"",
    "lint": "oxlint --deny-warnings src server api tests"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "motion": "^14.4.0",
    "three": "^0.186.1",
    "umap-js": "^1.4.0"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "vite": "^8.3.4"
  }
}
