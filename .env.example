# Spotify app credentials (https://developer.spotify.com/dashboard). Read by the backend only.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Last.fm API key (https://www.last.fm/api/account/create). Optional: adds community genre
# tags for artists Wikidata/MusicBrainz don't describe.
LASTFM_API_KEY=

# Optional. Defaults to <current origin>/api/auth/callback, e.g. https://your-app.vercel.app/api/auth/callback
# or http://127.0.0.1:5173/api/auth/callback locally. Must exactly match a Redirect URI in the Spotify dashboard.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# Encrypts the session cookie. Defaults to SPOTIFY_CLIENT_SECRET; set a random value in production.
# SESSION_SECRET=

# PORT=5173
# HOST=127.0.0.1
